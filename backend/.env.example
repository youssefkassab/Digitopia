# Digitopia Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server
NODE_ENV=production
PORT=10000

# Database - MySQL
DB_HOST=your-mysql-host.render.com
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=digitopia
DB_PORT=3306

# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
AI_DB_NAME=digitopia_ai
AI_COLLECTION_NAME=curriculum
REPLACE_AI_DB=false

# Security - Generate a strong random string (32+ characters)
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters_long

# Google AI API
GOOGLE_API_KEY=your_google_ai_api_key_here

# CORS - Your Render app URL
CORS_ORIGIN=https://your-app-name.onrender.com

# Frontend URL - Used for CSP and redirects
FRONTEND_URL=https://alm-quest.onrender.com

# Logging
LOG_LEVEL=info
